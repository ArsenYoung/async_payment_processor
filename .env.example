POSTGRES_DB=payments
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change-me-rabbitmq
API_KEY=change-me-api-key
LOG_LEVEL=INFO
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=1.0
OUTBOX_PUBLISH_TIMEOUT=5.0
WEBHOOK_TIMEOUT=5.0
WEBHOOK_REQUEST_DEADLINE=5.0
RETRY_BASE_DELAY=1.0
CONSUMER_PREFETCH_COUNT=5

# Used when running the API outside Docker.
DATABASE_URL=postgresql+asyncpg://postgres:change-me-postgres@localhost:5432/payments
RABBITMQ_URL=amqp://guest:change-me-rabbitmq@localhost:5672/
